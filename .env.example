# Local demo only. Run npm run setup to create .env with random secrets.
# Never commit .env or .payflow-private/. Never reuse production credentials.
COMPOSE_PROJECT_NAME=payflow-ai-demo
N8N_BIND_PORT=5679
N8N_URL=http://127.0.0.1:5679
PAYFLOW_PUBLIC_ORIGIN=http://127.0.0.1:3005
POSTGRES_ADMIN_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
N8N_ENCRYPTION_KEY=
PAYFLOW_ENGINE_SECRET=
# Optional: your own Sandbox / Gemini credentials, imported into this demo only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
